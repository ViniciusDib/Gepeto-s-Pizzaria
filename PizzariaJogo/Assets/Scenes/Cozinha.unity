--- !u!102 &2050351102
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2050351099}
  m_Text: "<b>RECEITAS DA CASA</b>\n<b>Mussarela</b>  <color=#f2c46d>R$ 20</color>\n  Massa 1 \u203A Molho 2 \u203A Queijo 3\n<b>Marguerita</b>  <color=#f2c46d>R$ 25</color>\n  Massa 1 \u203A Molho 2 \u203A Queijo 2 \u203A Tomate 3\n  Manjeric\xE3o 2\n<b>Calabresa</b>  <color=#f2c46d>R$ 28</color>\n  Massa 1 \u203A Molho 2 \u203A Queijo 2 \u203A Calabresa 3\n  Cebola 2\n<b>Napolitana</b>  <color=#f2c46d>R$ 28</color>\n  Massa 1 \u203A Molho 2 \u203A Queijo 3 \u203A Tomate 2\n  Azeitona 2\n<b>Pizza do Chef</b>  <color=#f2c46d>R$ 38</color>\n  Massa 1 \u203A Molho 1 \u203A Queijo 2 \u203A Calabresa 2\n  Cebola 1 \u203A Azeitona 2 \u203A Manjeric\xE3o 1\n<b>Domingueira</b>  <color=#f2c46d>R$ 36</color>\n  Massa 1 \u203A Molho 3 \u203A Queijo 1 \u203A Tomate 2\n  Calabresa 2 \u203A Manjeric\xE3o 2"
  m_OffsetZ: 0
  m_CharacterSize: 0.0055
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 96
  m_FontStyle: 0
  m_RichText: 1
